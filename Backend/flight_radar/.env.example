# Application
APP_NAME=FlightRadar Intelligence Backend
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
# Keep true for local compatibility; set false in production.
ENABLE_LEGACY_UNPREFIXED_ROUTES=true

# Security / JWT
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Auth user
AUTH_USERNAME=admin
# Generate hash with: make auth-hash
AUTH_PASSWORD_HASH=
# Commercial API access control:
# API_KEYS format => name:key,name2:key2 (key length >= 16)
REQUIRE_API_KEY=false
API_KEYS=
# Keep false in production unless you explicitly want public docs
EXPOSE_DOCS_IN_PRODUCTION=false
DEFAULT_API_PLAN=free
# Optional per-key plan mapping: keyName:plan,keyName2:plan2
API_KEY_PLANS=
# Requests per RATE_LIMIT_WINDOW_SECONDS by plan
PLAN_REQUEST_LIMITS=free:60,pro:300,enterprise:1200
ENABLE_API_USAGE_LOGGING=true
API_USAGE_LOG_RETENTION_DAYS=90

# CORS (comma-separated)
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# OpenSky
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_POLL_INTERVAL=15

# Aircraft data sources (comma-separated: opensky,adsblol,icao)
AIRCRAFT_SOURCES=opensky

# ADSB.lol
ADSBLOL_BASE_URL=https://api.adsb.lol
ADSBLOL_RADIUS_NM=400
ADSBLOL_API_KEY=

# ICAO aircraft (optional)
ICAO_API_KEY=
ICAO_AIRCRAFT_URL=

# Weather source: openweather | aviationweather | icao
WEATHER_SOURCE=openweather

# OpenWeather (required only when WEATHER_SOURCE=openweather)
OPENWEATHER_API_KEY=replace-with-api-key
OPENWEATHER_POLL_INTERVAL=300
OPENWEATHER_CACHE_TTL=600

# AviationWeather.gov (used when WEATHER_SOURCE=aviationweather)
AVIATIONWEATHER_BASE_URL=https://aviationweather.gov/api/data/metar
AVIATIONWEATHER_HOURS=1

# ICAO weather (required when WEATHER_SOURCE=icao)
ICAO_WEATHER_URL=

# Airspace (India default)
AIRSPACE_MIN_LAT=6.0
AIRSPACE_MAX_LAT=38.0
AIRSPACE_MIN_LON=68.0
AIRSPACE_MAX_LON=98.0
WEATHER_GRID_STEP=3

# Conflict engine
CONFLICT_H_SEP_KM=10.0
CONFLICT_V_SEP_FT=1000.0
CONFLICT_LOOKAHEAD_SECONDS=600

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
