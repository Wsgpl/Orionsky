# Application
APP_NAME=FlightRadar Intelligence Backend
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api/v1
ENABLE_LEGACY_UNPREFIXED_ROUTES=false
WORKERS=1

# Security / JWT
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=YOUR_SECRET_KEY_HERE_CHANGE_THIS_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Auth user
AUTH_USERNAME=admin
# Optional for local/private setups. When set, this overrides AUTH_PASSWORD_HASH.
AUTH_PASSWORD=YOUR_PASSWORD_HERE
# Generate hash with: make auth-hash
AUTH_PASSWORD_HASH=YOUR_BCRYPT_HASH_HERE
FRONTEND_APP_URL=http://localhost:5173
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FlightRadar Intelligence
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# CORS (comma-separated)
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# ========== AIRCRAFT DATA SOURCES ==========
# PRIMARY: Spire Aviation API
# Get your token from: https://api.airsafe.spire.com
SPIRE_API_TOKEN=YOUR_SPIRE_TOKEN_HERE
SPIRE_API_URL=https://api.airsafe.spire.com/v2/targets/stream?
SPIRE_POLL_INTERVAL=15
SPIRE_TIMEOUT=30

# Aircraft data sources (using Spire as primary)
AIRCRAFT_SOURCES=spire

# OpenSky (optional fallback)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_POLL_INTERVAL=15

# ADSB.lol (optional fallback)
ADSBLOL_BASE_URL=https://api.adsb.lol
ADSBLOL_RADIUS_NM=400
ADSBLOL_API_KEY=

# Geographic bounds
AIRCRAFT_MIN_LAT=5.0
AIRCRAFT_MAX_LAT=37.0
AIRCRAFT_MIN_LON=68.0
AIRCRAFT_MAX_LON=97.0
ADSBEXCHANGE_RADIUS_NM=150
# ========== END AIRCRAFT SOURCES ==========

# Open-Meteo
GENERAL_WEATHER_PROVIDER=openmeteo
AVIATION_WEATHER_PROVIDER=awc
AIR_QUALITY_PROVIDER=copernicus_cams
DISASTER_PROVIDER=copernicus_cems
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_POLL_INTERVAL=300
OPEN_METEO_CACHE_TTL=600
AWC_BASE_URL=https://aviationweather.gov/api/data
AWC_POLL_INTERVAL=300
AWC_CACHE_TTL=600
COPERNICUS_CAMS_ENABLED=true
COPERNICUS_CAMS_ADS_URL=https://ads.atmosphere.copernicus.eu/api
COPERNICUS_CAMS_ADS_KEY=YOUR_COPERNICUS_KEY_HERE
COPERNICUS_CAMS_DATASET=cams-global-atmospheric-composition-forecasts
COPERNICUS_CEMS_ENABLED=true
COPERNICUS_CEMS_RAPID_MAPPING_URL=https://rapidmapping.emergency.copernicus.eu/backend/dashboard-api/public-activations/
COPERNICUS_CEMS_RISK_RECOVERY_URL=https://riskandrecovery.emergency.copernicus.eu/api/public-activations/
COPERNICUS_CEMS_PAGE_LIMIT=25

# Airspace (India default)
AIRSPACE_MIN_LAT=6.0
AIRSPACE_MAX_LAT=38.0
AIRSPACE_MIN_LON=68.0
AIRSPACE_MAX_LON=98.0
WEATHER_GRID_STEP=1

# Default Radar Map View
DEFAULT_MAP_CENTER_LAT=22.0
DEFAULT_MAP_CENTER_LON=82.0
DEFAULT_MAP_ZOOM=4.6

# Conflict engine
CONFLICT_H_SEP_KM=10.0
CONFLICT_V_SEP_FT=1000.0
CONFLICT_LOOKAHEAD_SECONDS=600

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Commercial API access
REQUIRE_API_KEY=true
API_KEYS=public:YOUR_PUBLIC_API_KEY_HERE_12345,partner:YOUR_PARTNER_API_KEY_HERE_12345
DEFAULT_API_PLAN=free
API_KEY_PLANS=public:free,partner:pro
PLAN_REQUEST_LIMITS=free:60,pro:300,enterprise:1200
ENABLE_API_USAGE_LOGGING=true
API_USAGE_LOG_RETENTION_DAYS=90
EXPOSE_DOCS_IN_PRODUCTION=false

PYTHONPATH=.
