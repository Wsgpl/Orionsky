# Application
APP_NAME=FlightRadar Intelligence Backend
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api/v1
ENABLE_LEGACY_UNPREFIXED_ROUTES=false

# Security / JWT
SECRET_KEY=replace-with-64-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_USERNAME=admin
# Optional fallback if you are not using a bcrypt hash. When set, this overrides AUTH_PASSWORD_HASH.
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=replace-with-bcrypt-hash
FRONTEND_APP_URL=https://yourdomain.com
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=60
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=FlightRadar Intelligence
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# Commercial API access
REQUIRE_API_KEY=true
API_KEYS=public:replace-with-random-32plus-key,partner:replace-with-random-32plus-key
DEFAULT_API_PLAN=free
API_KEY_PLANS=public:free,partner:pro
PLAN_REQUEST_LIMITS=free:60,pro:300,enterprise:1200
ENABLE_API_USAGE_LOGGING=true
API_USAGE_LOG_RETENTION_DAYS=90
EXPOSE_DOCS_IN_PRODUCTION=false

# CORS (only your frontend domains)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_MAX_CONNECTIONS=20

# Aircraft sources
AIRCRAFT_SOURCES=opensky,adsblol
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
ADSBLOL_BASE_URL=https://api.adsb.lol
ADSBLOL_RADIUS_NM=400
ADSBLOL_API_KEY=

# Optional ICAO aircraft
ICAO_API_KEY=
ICAO_AIRCRAFT_URL=

# Open-Meteo weather / forecast
GENERAL_WEATHER_PROVIDER=openmeteo
AVIATION_WEATHER_PROVIDER=awc
AIR_QUALITY_PROVIDER=copernicus_cams
DISASTER_PROVIDER=copernicus_cems
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_POLL_INTERVAL=300
OPEN_METEO_CACHE_TTL=600
AWC_BASE_URL=https://aviationweather.gov/api/data
AWC_POLL_INTERVAL=300
AWC_CACHE_TTL=600
COPERNICUS_CAMS_ENABLED=false
COPERNICUS_CAMS_ADS_URL=https://ads.atmosphere.copernicus.eu/api
COPERNICUS_CAMS_ADS_KEY=
COPERNICUS_CAMS_DATASET=cams-global-atmospheric-composition-forecasts
COPERNICUS_CEMS_ENABLED=false
COPERNICUS_CEMS_RAPID_MAPPING_URL=https://rapidmapping.emergency.copernicus.eu/backend/dashboard-api/public-activations/
COPERNICUS_CEMS_RISK_RECOVERY_URL=https://riskandrecovery.emergency.copernicus.eu/api/public-activations/
COPERNICUS_CEMS_PAGE_LIMIT=25

# Aircraft coverage bounds (India recommended)
AIRCRAFT_MIN_LAT=5.0
AIRCRAFT_MAX_LAT=37.0
AIRCRAFT_MIN_LON=68.0
AIRCRAFT_MAX_LON=97.0
ADSBEXCHANGE_RADIUS_NM=150

# Weather airspace (India default)
AIRSPACE_MIN_LAT=6.0
AIRSPACE_MAX_LAT=38.0
AIRSPACE_MIN_LON=68.0
AIRSPACE_MAX_LON=98.0
WEATHER_GRID_STEP=1

# Default Radar Map View
DEFAULT_MAP_CENTER_LAT=22.0
DEFAULT_MAP_CENTER_LON=82.0
DEFAULT_MAP_ZOOM=4.6
WEATHER_MAP_CENTER_LAT=20.5937
WEATHER_MAP_CENTER_LON=78.9629
WEATHER_MAP_ZOOM=4.5

# Conflict engine
CONFLICT_H_SEP_KM=10.0
CONFLICT_V_SEP_FT=1000.0
CONFLICT_LOOKAHEAD_SECONDS=600

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
