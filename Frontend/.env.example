VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token
VITE_OWM_KEY=your_openweather_tile_key

# Preferred for public/commercial frontend access:
# VITE_API_KEY=your_public_api_key

# Optional alternative (admin/private dashboards only):
VITE_AUTH_USERNAME=
VITE_AUTH_PASSWORD=

# Map Configuration
VITE_MAP_CENTER_LAT=22
VITE_MAP_CENTER_LON=82
VITE_MAP_DEFAULT_ZOOM=4.6
VITE_WEATHER_MAP_CENTER_LAT=20.5937
VITE_WEATHER_MAP_CENTER_LON=78.9629
VITE_WEATHER_MAP_DEFAULT_ZOOM=4.5

# Tile Server URLs
VITE_BASEMAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_PRECIPITATION_TILE_URL=https://tilecache.rainviewer.com/v2/radar/0/256/{z}/{x}/{y}/2/1_1.png

# Weather Display Thresholds
VITE_HUMIDITY_DETAIL_ZOOM=7.1
VITE_PRESSURE_STATE_ZOOM=4.6
VITE_PRESSURE_CAPITAL_ZOOM=5.8
VITE_PRESSURE_REGION_ZOOM=7.1
VITE_PRESSURE_DETAIL_ZOOM=8.5

# Animation Parameters
VITE_WIND_PARTICLES_COUNT=2000
VITE_WIND_PARTICLE_SPEED=0.8
VITE_AIRCRAFT_ANIMATION_STEPS=18
VITE_AIRCRAFT_ANIMATION_DURATION=14000
